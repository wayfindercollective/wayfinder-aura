[Unit]
Description=Wayfinder Aura mode supervisor (SteamOS Game Mode lifecycle)
After=default.target
Before=wayfinder-aura.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/wayfinder-mode-supervisor.py
RuntimeDirectory=wayfinder-aura-logs
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
Restart=on-failure
RestartSec=3
StandardOutput=append:%t/wayfinder-aura-logs/wayfinder-mode-supervisor.log
StandardError=append:%t/wayfinder-aura-logs/wayfinder-mode-supervisor.log

[Install]
WantedBy=default.target
