[Unit]
Description=Wayfinder Aura trigger daemon (evdev -> Unix socket; works in Desktop and Game Mode)
# Supersedes r4-f3-bridge.service — do not enable both (double-trigger on BTN_THUMBR).
Conflicts=r4-f3-bridge.service
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/wayfinder-trigger-daemon.py
RuntimeDirectory=wayfinder-aura-logs
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
Restart=on-failure
RestartSec=3
StandardOutput=append:%t/wayfinder-aura-logs/wayfinder-trigger.log
StandardError=append:%t/wayfinder-aura-logs/wayfinder-trigger.log

[Install]
WantedBy=default.target
